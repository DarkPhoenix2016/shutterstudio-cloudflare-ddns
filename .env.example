# ===================================================
# Cloudflare DDNS Updater Environment Variables
# Copy to `.env` for production or local execution.
# NEVER commit your real API token or credentials!
# ===================================================

# Cloudflare API Token (Requires Zone.DNS Edit permissions)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Cloudflare Zone ID (Found on domain overview page in Cloudflare Dashboard)
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id_here

# Target Cloudflare DNS Record ID (A record ID)
CLOUDFLARE_DNS_RECORD_ID=your_cloudflare_dns_record_id_here

# Target DNS record domain name (e.g. test.shutterstudio.app or shutterstudio.app)
CLOUDFLARE_DNS_RECORD_NAME=test.shutterstudio.app

# Interval in seconds between IP checks (Default: 300 = 5 minutes)
DDNS_INTERVAL_SECONDS=300
